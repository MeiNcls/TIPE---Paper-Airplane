from pylab import *
from scipy.integrate import solve_ivp

dtr = pi/180
g = 9.81 #m/s**2
rho = 1.2 #kg/m3

#géométrie
a = 2e-2 #m
#l= 10e-2 #m
#L = 7.5e-2 #m
#alpha = 20*dtr #rad
S = 50e-4 #m2
m = 5e-3 #kg
[A1,B1,C1,D1,E1,F1] = [1e-5,1e-5,1e-5,0,0,0]

phi = 40*dtr

#base liée au sol
u = array([1,0,0]).T #Bav
v = array([0,1,0]).T #Bav
w = array([0,0,1]).T #Bav


#valeurs par défaut, à faire varier ==> hyperparamaètres
Cx = 0.5 #à changer
Cz = 0.9 #à changer
#K = 1e-4 #kg/m

dt = 0.01 #pas de temps de la simulation
n = 1000*3 #nombres de points de la simulation
#R = 3 #m (rayon d'une boucle)
#d = 4
#v_lin = 2 #m/s
#Y0 = array([0,0,0,v_lin,d*v_lin,(v_lin*(1+d**2)**0.5)/R])  #conditions initiales
Y0 = array([0,0,0,0.1,2,0,0,0])

I = array([[A1,-F1,-E1],
          [-F1,B1,-D1],
          [-E1,-D1,C1]]) #Bav

def Rpsi(a) :
    #a *= dtr
    i = array([[cos(a),-sin(a),0],
               [sin(a),cos(a),0],
               [0,0,1]])
    return i

def Rphi(a) :
    i = array([[1,0,0],
              [0,cos(a),-sin(a)],
              [0,sin(a),cos(a)]])
    return i


def F(t,Y) :
    P = Y[:3]
    V = Y[4:7]
    psi = Y[3]
    dpsi = Y[7]


    x0 = Rpsi(psi) @ Rphi(phi) @ u # Bav
    y0 = Rpsi(psi) @ Rphi(phi) @ v # Bav
    z0 = Rpsi(psi) @ Rphi(phi) @ w # Bav
    x1 = u
    z1 = z0 

    Omega = dpsi*z1
    Sigma = I @ Omega

    vitesse = linalg.norm(V)

    Fpes = -m*g*z0
    Fair = (1/2)*rho*S*(vitesse**2)*(Cx*u + Cz*w)

    Mair = cross(Fair,-a*u)

    ddpsi = (1/B1/sin(psi))*(Mair.T @ v - cross(Omega,Sigma).T @ v)
    A = array([[x0.T @ u, y0.T @ u, z0.T @ u],
              [x0.T @ v, y0.T @ v, z0.T @ v],
              [x0.T @ w, y0.T @ w, z0.T @ w]])
    B = Fair + Fpes

    #cond.append(linalg.det( A ))
    dV =linalg.solve(A,B)
    return np.concatenate((V,array([dpsi]),dV,array([ddpsi])))

sol = solve_ivp(F, (0,n*dt), Y0)
Y = sol.y
t = sol.t
x_tab, y_tab = Y[0,:], Y[1,:]
close(1)
figure(1)
plot(x_tab,y_tab)
title("trajectoire plane")
xlabel("x(m)")
ylabel("y(m)")

